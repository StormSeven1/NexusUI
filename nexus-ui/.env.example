# 复制为 nexus-ui/.env.local 后重启 npm run dev。
# 每个 KEY 在 .env 里只能生效一行：下面「————」下第一组为联网默认可跑；离线/备选整段在注释里，切换时注释掉当前生效段、取消注释目标段（或只改样式/底图几行）。

################################################################################
# 二维 MapLibre
################################################################################

# —— 联网：Carto GL 矢量样式（需外网）——
NEXT_PUBLIC_MAP2D_STYLE_URL=https://basemaps.cartocdn.com/gl/dark-matter-gl-style/style.json
NEXT_PUBLIC_MAP2D_MINI_STYLE_URL=https://basemaps.cartocdn.com/gl/dark-matter-nolabels-gl-style/style.json
NEXT_PUBLIC_MAP2D_INITIAL_CENTER=120.217,38.105
NEXT_PUBLIC_MAP2D_INITIAL_ZOOM=10

# 为 true：2D 地图不绘制航迹点/线/标牌（列表与 track-store 仍更新）。默认不写或 false。
# NEXT_PUBLIC_DISABLE_MAP_TRACK_RENDERING=true

# —— 离线：同源 JSON（public/map-styles/offline-map.json），瓦片在 JSON 里写 pmtiles://…；见 public/tiles/README.txt ——
# NEXT_PUBLIC_MAP2D_STYLE_URL=/map-styles/offline-map.json
# NEXT_PUBLIC_MAP2D_MINI_STYLE_URL=/map-styles/offline-map.json
# NEXT_PUBLIC_MAP2D_INITIAL_CENTER=120.217,38.105
# NEXT_PUBLIC_MAP2D_INITIAL_ZOOM=10

# 可选栅格 XYZ 底图（图层面板「地图」区；JSON 数组，一项示例）
# 141 现场：仅配本机瓦片服务
# NEXT_PUBLIC_MAP2D_RASTER_LAYERS=[{"id":"local-raster-tiles","name":"本地瓦片地图","url":"http://192.168.18.141:8200/localtiles/{z}/{x}/{y}.png","enabled":false,"minZoom":0,"maxZoom":18,"tileSize":256,"type":"xyz"}]
# 28.9 现场：deploy-28.9.sh 写入，或手动改为 192.168.28.9
# NEXT_PUBLIC_MAP2D_RASTER_LAYERS=[{"id":"local-raster-tiles","name":"本地瓦片地图","url":"http://192.168.28.9:8200/localtiles/{z}/{x}/{y}.png","enabled":false,"minZoom":0,"maxZoom":18,"tileSize":256,"type":"xyz"}]

################################################################################
# 三维 Cesium（底图仅一条 URL 模板，无内置默认；离线请改为内网或本机可访问的 XYZ）
################################################################################

# —— 联网：示例为 Carto 深色栅格 XYZ（需外网；可整行改成任意其它 XYZ 模板）——
NEXT_PUBLIC_MAP3D_IMAGERY_URL=https://basemaps.cartocdn.com/dark_all/{z}/{x}/{y}@2x.png
NEXT_PUBLIC_MAP3D_INITIAL_CENTER=120.217,38.105
NEXT_PUBLIC_MAP3D_INITIAL_ZOOM=10

# —— 离线：示例为内网自托管 XYZ（按你实际服务改主机与路径）——
# NEXT_PUBLIC_MAP3D_IMAGERY_URL=http://192.168.1.10/tiles/{z}/{x}/{y}.png
# NEXT_PUBLIC_MAP3D_INITIAL_CENTER=120.217,38.105
# NEXT_PUBLIC_MAP3D_INITIAL_ZOOM=10

################################################################################
# 后端（Next rewrites 代理目标）
################################################################################

# Custombackend/app/.env：ENABLE_DRONE_DATA_STORAGE 等后端专用项（与 nexus-ui/.env.local 分离）
# 相机 DDS 模式也可写 Custombackend/app/.env：NEXUS_DDS_CAMERA_STATUS_MODE=legacy|entity|both
# Keycloak 鉴权仅写在 Custombackend/app/.env（AUTH_ENABLED / KEYCLOAK_*）；前端经
# GET {http.backendUrl}/api/v1/auth/config 拉取，勿在此配置 KEYCLOAK_URL。
BACKEND_URL=http://127.0.0.1:27003
# Custombackend：DDS 无人机数据落盘 data/drone_logs（jsonl）；须写入 Custombackend/app/.env，改后重启 Custombackend
# ENABLE_DRONE_DATA_STORAGE=false

# 告警服务（航迹告警删除 → POST /api/alarm_filter；经 Next `/api/alarm-filter` 转发）
# NEXUS_ALARM_SERVER_URL=http://192.168.18.141:8019
# TrackManager 目标类型 gRPC（右键「设置目标类型」；对齐 AlarmSys GrpcTargetType）
# NEXUS_TARGET_TYPE_GRPC_URL=192.168.18.141:60054

# —— WebSocket Nginx 隧道（HTTPS 同源 wss）——
# 用 ./dev-start.sh / ./prod-start-nginx.sh 时勿在 .env.local 写下面两项，由脚本经 Docker -e 注入：
#   开发 → NEXT_PUBLIC_NGINX_WS_PUBLIC_HOSTPORT=<IP>:22402（dev-wss-nginx）
#   生产 → NEXT_PUBLIC_NGINX_WS_PUBLIC_HOSTPORT=<IP>:21911（prod-start-nginx）
# NEXT_PUBLIC_WS_USE_NGINX_TUNNEL=true
# NEXT_PUBLIC_NGINX_WS_PUBLIC_HOSTPORT=192.168.18.141:22402
# 航迹与 HTTP 后端地址：仓库根 ./dev-start.sh → public/app-config.dev.json；
# ./prod-start.sh / ./prod-start-nginx.sh → public/app-config.prod.json（从 app-config.json 复制并写端口，互不覆盖）。
# 容器经 NEXT_PUBLIC_APP_CONFIG_URL 指向对应文件；须安装 jq。可选 APP_CONFIG_LAN_HOST=某 IP。
# NEXT_PUBLIC_APP_CONFIG_URL=/app-config.dev.json

################################################################################
# 航迹评估（C++ 数据服务 WebSocket，与 mapbox-vue2 SystemConfig.websocket 同源，非 Custombackend 态势 WS）
################################################################################
# 默认 ws://127.0.0.1:12600/ws/test-client；与 mapbox-vue2 public/sysconfig.js dataServiceUrl 对齐
# NEXT_PUBLIC_TRACK_EVAL_WS_URL=ws://192.168.28.9:12600/ws/test-client

################################################################################
# 相机 / 设备注册 / WebRTC（服务端；见 app/api/eo-drone-registry、eo-webrtc-sources）
################################################################################
# NEXUS_ENTITIES_LIST_URL=http://192.168.18.141:8090/api/v1/entities?page=1&size=100
# 18.141 本机 camServer：8088（实体 GET /api/v1/entity/:id 与任务 POST /api/v1/tasks 同源）
# NEXT_PUBLIC_NEXUS_CAMERA_MANAGEMENT_URL=http://192.168.18.141:8088
# 28.9 现场由 deploy-28.9.sh 写 :8089，勿把 28.9 端口写进 141 的 .env.local
# 兼容旧键（建议改用 NEXT_PUBLIC_NEXUS_CAMERA_MANAGEMENT_URL）
# CAMERA_ENTITY_BASE_URL=http://192.168.18.141:8088

################################################################################
# 无人机 / 私有云 / MQTT（服务端；见 app/api/uav-control）
################################################################################
# 无人机平台根 URL（与私有云同一地址时只设这一项即可；旧名 NEXUS_DRONE_PRIVATE_CLOUD_BASE_URL / NEXUS_UAV_PLATFORM_BASE_URL 仍可作备选）
# NEXUS_DRONE_PLATFORM_BASE_URL=http://192.168.18.141:8890
# NEXUS_DRONE_PRIVATE_CLOUD_BASE_URL=
# NEXUS_UAV_PLATFORM_BASE_URL=
# NEXUS_DRONE_PLATFORM_USERNAME=adminPC
# NEXUS_DRONE_PLATFORM_PASSWORD=
# NEXUS_UAV_TASK_API_BASE_URL=
# NEXUS_UAV_TASK_OWNER_ENTITY_ID=uav-001
# NEXUS_UAV_MQTT_BROKER_URL=
# NEXUS_UAV_MQTT_USERNAME=
# NEXUS_UAV_MQTT_PASSWORD=
# NEXUS_UAV_CTRL_HOTBACK_URL=/api4third/control/api/v1/devices/jobs/remote-debug-control
# NEXUS_UAV_CTRL_HOTBACK_MQTT_TOPIC=thing/product/{{airportSN}}/services
# NEXUS_UAV_CTRL_TAKEOFF_MQTT_TOPIC=thing/product/{{airportSN}}/services
# NEXUS_UAV_CTRL_EMERGENCY_MQTT_TOPIC=thing/product/{{airportSN}}/drc/down
# NEXUS_UAV_CTRL_TAKEOFF_DEFAULT_HEIGHT_M=120
# NEXUS_UAV_CTRL_AIRPORT_DEFAULT_LAT=
# NEXUS_UAV_CTRL_AIRPORT_DEFAULT_LON=

################################################################################
# 光电视频客户端（NEXT_PUBLIC_*）
################################################################################
# NEXT_PUBLIC_MQTT_WS_URL=
# NEXT_PUBLIC_EO_DETECTION_WS_URL=
# 第三方相机组播末端 host:port（与实体注册表合并后的流条目共用；改后需重启 next dev）
# NEXT_PUBLIC_EO_THIRD_PARTY_CAMERA_MULTICAST_UDP=239.192.110.99:8568
# NEXT_PUBLIC_NEXUS_UAV_ZLM_WEBRTC_BASE_URL=
# NEXT_PUBLIC_UAV_ZLM_WEBRTC_BASE=
# NEXT_PUBLIC_ZLM_WEBRTC_PORT=1985
# NEXT_PUBLIC_APP_CONFIG_URL=
# NEXT_PUBLIC_BASE_PATH=
# 光电视频调试 UI：左上角 WebRTC 状态条 + 底部「目标跟踪 · 调试」。设为 false 则不挂载。
# NEXT_PUBLIC_EO_VIDEO_DEBUG_UI=false
# 为 true：相机开检测时主画面用 WebCodecs + Canvas（与 base-vue 思路类似），需 Insertable Streams；`<video>` 仍解码但 opacity-0。默认不写为关闭。
# NEXT_PUBLIC_EO_VIDEO_WEBCODECS_CANVAS=true
# false：不将编码帧 passthrough 到 <video>，且不绑 srcObject（须与 WEBCODECS_CANVAS 同开）；默认 true（不写即开启 passthrough）。
# NEXT_PUBLIC_EO_VIDEO_HARDWARE_PASSTHROUGH=false
# 光电视频 object-fit：fill=拉伸铺满（默认，对齐 Qt）；cover=等比裁边；contain=等比+黑边
# NEXT_PUBLIC_EO_VIDEO_OBJECT_FIT=fill

################################################################################
# 任务管理根地址（LangGraph / 处置 / 快捷工作流 / workflow WS；与 Qt LangGraph 同源）
# 浏览器与服务端共用；改后重启 dev。未设时可回退 LangGraphIp+LangGraphPort 或代码默认 192.168.18.103:8000。
################################################################################
# NEXT_PUBLIC_NEXUS_TASK_MANAGEMENT_URL=http://192.168.18.103:8000
# 仅服务端别名（与上一行二选一即可；浏览器处置/工作流须用 NEXT_PUBLIC_ 前缀）
# NEXUS_TASK_MANAGEMENT_URL=http://192.168.18.103:8000

################################################################################
# 右侧智能助手（未设上一项时回退；与 Qt Config.ini LangGraphIp / LangGraphPort 对齐）
################################################################################
# LangGraphIp=192.168.18.103
# LangGraphPort=8000

################################################################################
# 知识库查询（融控任务管理 `POST /api/v1/chat/stream`；`POST /api/knowledge-base-chat`）
################################################################################
# NEXT_PUBLIC_NEXUS_KNOWLEDGE_BASE_URL=http://192.168.18.103:21914
# WatchSystemDbQaIp=192.168.18.103
# WatchSystemDbQaPort=21914

################################################################################
# 智能语音（`POST /api/speech-to-text`、`POST /api/text-to-speech`）
# NEXUS_SPEECH_MODE=1：Qt 同源 /asr + /tts；=2：chat/completions ASR + /v1/tts
################################################################################
# NEXUS_SPEECH_MODE=1

# Mode 1 ASR（`POST /api/speech-to-text` → Qt LLMMode==2 `/asr`）
# NEXUS_SPEECH_ASR_URL=http://192.168.18.141/asr
# 或拆写（port 为空或 80 时不带端口）：
# NEXUS_SPEECH_ASR_HOST=192.168.18.141
# NEXUS_SPEECH_ASR_PATH=/asr

# Mode 1 TTS（`POST /api/text-to-speech` → Qt TTSClient `/tts`）
# NEXUS_SPEECH_TTS_URL=http://192.168.18.141:9880/tts

# Mode 2 ASR / TTS
# NEXUS_SPEECH_ASR_V2_URL=http://192.168.18.141:8001/v1/chat/completions
# NEXUS_SPEECH_TTS_V2_URL=http://192.168.18.141:8002/v1/tts
# NEXUS_SPEECH_TTS_V2_LANGUAGE=Chinese
# NEXUS_SPEECH_TTS_V2_SPEAKER=Vivian
# NEXUS_SPEECH_TTS_V2_INSTRUCT=用特别威严的语气说

################################################################################
# 光电截图/录像强制落盘（服务端本地文件系统）
################################################################################
# 默认：截图 C:\watch_data\pic\光电名称\ ；录像 C:\watch_data\video\光电名称\
# NEXUS_EO_CAPTURE_PIC_DIR=C:\watch_data\pic
# NEXUS_EO_CAPTURE_VIDEO_DIR=C:\watch_data\video

################################################################################
# 相机管理 → 任务状态 / 查证回调（与 Qt `InitTaskStatusHttp` 路径对齐）
# Next 启动后会在本机额外监听 TASK_STATUS_HTTP_PORT（默认 7774），与 Qt `m_nTaskHostPort` 用法一致：
#   PUT http://<主机>:7774/api/alarms/<告警ID>/task-status
# Body：`{ "taskStatus", "taskID"?, "cameraIndex"?, "trackID"?, "description"?, "minioBucket"|"bucket"?, "minioObjectKey"|"objectKey"?, "downloadUrl"|"imageUrl"? … }`
# 桶与对象键一般由库读出写入 Body；若未带 `downloadUrl`，服务端会用下方 MinIO 账号做 **presigned GET**（推荐私有桶）。
# 同源路径仍可通过 Next 主端口访问（例如 :3000），两条入口共用逻辑。
################################################################################
# TASK_STATUS_HTTP_PORT=7774
#
# TASK_STATUS_MINIO_ENDPOINT=http://192.168.18.141:9900
# TASK_STATUS_MINIO_ACCESS_KEY=minioadmin
# TASK_STATUS_MINIO_SECRET_KEY=minioadmin
# TASK_STATUS_MINIO_PRESIGN_EXPIRY_SEC=86400
# 或拆写：TASK_STATUS_MINIO_HOST=192.168.18.141 与 Qt 键名 TASK_STATUS_MINIO_PORT / MinioPort=9900
# TASK_STATUS_MINIO_PATH_STYLE=true
#
# Body 未带 bucket 时兜底默认桶（一般用库字段即可不写）
# TASK_STATUS_VERIFY_IMAGE_BUCKET=
# description 分段拼 key / key 无扩展名时追加
# TASK_STATUS_VERIFY_IMAGE_DEFAULT_EXT=.jpg
# 不配 AK/SK 且桶匿名可读时的直链前缀（备选）
# TASK_STATUS_MINIO_BROWSER_BASE_URL=http://192.168.18.141:9900
#
# HTTPS 页面若禁止加载 HTTP MinIO 图（混合内容）：已内置同源 `/api/task-status-image-proxy`（配好 TASK_STATUS_MINIO_* 后优先使用）
#
# 与 Qt 相同 PostgreSQL：查证 minio_multi_metadata、区域图层 area_table 等（PgDataAccessLayer 同源库）
# NEXUS_POSTGRES_URL=postgresql://USER:PASS@HOST:5432/DBNAME
# 兼容旧名（任选其一即可）：TASK_STATUS_PG_CONNECTION_STRING / TASK_STATUS_METADATA_DATABASE_URL
# TASK_STATUS_METADATA_QUERY_DELAY_MS=2000
# TASK_STATUS_INGEST_SECRET=
# TASK_STATUS_CORS_ORIGIN=
# NEXT_PUBLIC_TASK_STATUS_STREAM_URL=
# NEXT_PUBLIC_TASK_STATUS_CHAT_FEED=
