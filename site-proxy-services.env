# 现场对外服务（与 switch-site-mode.sh / render-prod-nginx.sh 配合）
#
# TYPE=gateway：NexusUI 多 upstream 网关（/wss-track、/ws 等）
# TYPE=simple：单 URL 透传
# DAILY_PORT=0：日常直连 UPSTREAM 原端口（不经 Nginx）
# DEMO_PORT：演示专用 Nginx 端口；switch-site-mode demo 时**追加**监听，不关闭 DAILY_PORT
#
# 141 现场 upstream 与 app-config.json softwareCompositionLinks 一致

PROXY_GATEWAY_SVC_ID=NEXUSUI

# NexusUI（日常 :21911 始终由 Nginx 提供；演示额外 :25311）
PROXY_SVC_NEXUSUI_ENABLED=true
PROXY_SVC_NEXUSUI_TYPE=gateway
PROXY_SVC_NEXUSUI_LABEL=NexusUI
PROXY_SVC_NEXUSUI_SCHEME=https
PROXY_SVC_NEXUSUI_DAILY_PORT=21911
PROXY_SVC_NEXUSUI_DEMO_PORT=25311

# 作战管理
PROXY_SVC_COMBAT_ENABLED=true
PROXY_SVC_COMBAT_TYPE=simple
PROXY_SVC_COMBAT_LABEL=作战管理
PROXY_SVC_COMBAT_UPSTREAM=http://192.168.18.141:24000
PROXY_SVC_COMBAT_DAILY_PORT=0
PROXY_SVC_COMBAT_DEMO_PORT=25312
PROXY_SVC_COMBAT_SCHEME=http

# 实体管理
PROXY_SVC_ENTITY_ENABLED=true
PROXY_SVC_ENTITY_TYPE=simple
PROXY_SVC_ENTITY_LABEL=实体管理
PROXY_SVC_ENTITY_UPSTREAM=http://192.168.18.141:7880
PROXY_SVC_ENTITY_DAILY_PORT=0
PROXY_SVC_ENTITY_DEMO_PORT=25313
PROXY_SVC_ENTITY_SCHEME=http

# 任务管理
PROXY_SVC_TASK_ENABLED=true
PROXY_SVC_TASK_TYPE=simple
PROXY_SVC_TASK_LABEL=任务管理
PROXY_SVC_TASK_UPSTREAM=http://192.168.18.141:8888
PROXY_SVC_TASK_DAILY_PORT=0
PROXY_SVC_TASK_DEMO_PORT=25314
PROXY_SVC_TASK_SCHEME=http

# 相机管理（日常 base-vue HTTPS :21915 直出；演示 Nginx :25315）
PROXY_SVC_CAMERA_ENABLED=true
PROXY_SVC_CAMERA_TYPE=simple
PROXY_SVC_CAMERA_LABEL=相机管理
PROXY_SVC_CAMERA_UPSTREAM=https://192.168.18.141:21915
PROXY_SVC_CAMERA_DAILY_PORT=0
PROXY_SVC_CAMERA_DEMO_PORT=25315
PROXY_SVC_CAMERA_SCHEME=https

# 无人机管理（上游在 115）
PROXY_SVC_UAV_ENABLED=true
PROXY_SVC_UAV_TYPE=simple
PROXY_SVC_UAV_LABEL=无人机管理
PROXY_SVC_UAV_UPSTREAM=http://192.168.18.115:88
PROXY_SVC_UAV_DAILY_PORT=0
PROXY_SVC_UAV_DEMO_PORT=25316
PROXY_SVC_UAV_SCHEME=http

# 告警管理（日常 alarm_web_ui :21917 直出；演示 Nginx :25317）
PROXY_SVC_ALARM_ENABLED=true
PROXY_SVC_ALARM_TYPE=simple
PROXY_SVC_ALARM_LABEL=告警管理
PROXY_SVC_ALARM_UPSTREAM=http://192.168.18.141:21917
PROXY_SVC_ALARM_DAILY_PORT=0
PROXY_SVC_ALARM_DEMO_PORT=25317
PROXY_SVC_ALARM_SCHEME=http

# 数据管理（上游在 103）
PROXY_SVC_DATA_ENABLED=true
PROXY_SVC_DATA_TYPE=simple
PROXY_SVC_DATA_LABEL=数据管理
PROXY_SVC_DATA_UPSTREAM=http://192.168.18.103:8566
PROXY_SVC_DATA_DAILY_PORT=0
PROXY_SVC_DATA_DEMO_PORT=25318
PROXY_SVC_DATA_SCHEME=http

# 雷达管理（可选，顶栏亦有入口）
PROXY_SVC_RADAR_ENABLED=true
PROXY_SVC_RADAR_TYPE=simple
PROXY_SVC_RADAR_LABEL=雷达管理
PROXY_SVC_RADAR_UPSTREAM=http://192.168.18.141:22231
PROXY_SVC_RADAR_DAILY_PORT=0
PROXY_SVC_RADAR_DEMO_PORT=25319
PROXY_SVC_RADAR_SCHEME=http
