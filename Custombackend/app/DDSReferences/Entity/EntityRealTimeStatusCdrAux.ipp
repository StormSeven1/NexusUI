        const casia::device::status::WeaponStatus::WeaponRealTimeStatus& data,
        size_t& current_alignment)
{
    using namespace casia::device::status::WeaponStatus;

    static_cast<void>(data);

    eprosima::fastcdr::EncodingAlgorithmFlag previous_encoding = calculator.get_encoding();
    size_t calculated_size {calculator.begin_calculate_type_serialized_size(
                                eprosima::fastcdr::CdrVersion::XCDRv2 == calculator.get_cdr_version() ?
                                eprosima::fastcdr::EncodingAlgorithmFlag::DELIMIT_CDR2 :
                                eprosima::fastcdr::EncodingAlgorithmFlag::PLAIN_CDR,
                                current_alignment)};


        calculated_size += calculator.calculate_member_serialized_size(eprosima::fastcdr::MemberId(0),
                data.entityType(), current_alignment);

        calculated_size += calculator.calculate_member_serialized_size(eprosima::fastcdr::MemberId(1),
                data.entityId(), current_alignment);

        calculated_size += calculator.calculate_member_serialized_size(eprosima::fastcdr::MemberId(2),
                data.isVirtualWeapon(), current_alignment);

        calculated_size += calculator.calculate_member_serialized_size(eprosima::fastcdr::MemberId(3),
                data.dispositionType(), current_alignment);

        calculated_size += calculator.calculate_member_serialized_size(eprosima::fastcdr::MemberId(4),
                data.targetID(), current_alignment);

        calculated_size += calculator.calculate_member_serialized_size(eprosima::fastcdr::MemberId(5),
                data.targetName(), current_alignment);

        calculated_size += calculator.calculate_member_serialized_size(eprosima::fastcdr::MemberId(6),
                data.targetType(), current_alignment);

        calculated_size += calculator.calculate_member_serialized_size(eprosima::fastcdr::MemberId(7),
                data.taskType(), current_alignment);

        calculated_size += calculator.calculate_member_serialized_size(eprosima::fastcdr::MemberId(8),
                data.executionState(), current_alignment);

        calculated_size += calculator.calculate_member_serialized_size(eprosima::fastcdr::MemberId(9),
                data.executionTimeMs(), current_alignment);

        calculated_size += calculator.calculate_member_serialized_size(eprosima::fastcdr::MemberId(10),
                data.online(), current_alignment);

        calculated_size += calculator.calculate_member_serialized_size(eprosima::fastcdr::MemberId(11),
                data.position(), current_alignment);

        calculated_size += calculator.calculate_member_serialized_size(eprosima::fastcdr::MemberId(12),
                data.elec(), current_alignment);

        calculated_size += calculator.calculate_member_serialized_size(eprosima::fastcdr::MemberId(13),
                data.timestamp(), current_alignment);

        calculated_size += calculator.calculate_member_serialized_size(eprosima::fastcdr::MemberId(14),
                data.deviceState(), current_alignment);

        calculated_size += calculator.calculate_member_serialized_size(eprosima::fastcdr::MemberId(15),
                data.weaponState(), current_alignment);

        calculated_size += calculator.calculate_member_serialized_size(eprosima::fastcdr::MemberId(16),
                data.hitPoint(), current_alignment);

        calculated_size += calculator.calculate_member_serialized_size(eprosima::fastcdr::MemberId(17),
                data.launchPlatformID(), current_alignment);

        calculated_size += calculator.calculate_member_serialized_size(eprosima::fastcdr::MemberId(18),
                data.launchPlatformName(), current_alignment);

        calculated_size += calculator.calculate_member_serialized_size(eprosima::fastcdr::MemberId(19),
                data.attackAngle(), current_alignment);

        calculated_size += calculator.calculate_member_serialized_size(eprosima::fastcdr::MemberId(20),
                data.missDistance(), current_alignment);

        calculated_size += calculator.calculate_member_serialized_size(eprosima::fastcdr::MemberId(21),
                data.moveStep(), current_alignment);


    calculated_size += calculator.end_calculate_type_serialized_size(previous_encoding, current_alignment);

    return calculated_size;
}

template<>
eProsima_user_DllExport void serialize(
        eprosima::fastcdr::Cdr& scdr,
        const casia::device::status::WeaponStatus::WeaponRealTimeStatus& data)
{
    using namespace casia::device::status::WeaponStatus;

    eprosima::fastcdr::Cdr::state current_state(scdr);
    scdr.begin_serialize_type(current_state,
            eprosima::fastcdr::CdrVersion::XCDRv2 == scdr.get_cdr_version() ?
            eprosima::fastcdr::EncodingAlgorithmFlag::DELIMIT_CDR2 :
            eprosima::fastcdr::EncodingAlgorithmFlag::PLAIN_CDR);

    scdr
        << eprosima::fastcdr::MemberId(0) << data.entityType()
        << eprosima::fastcdr::MemberId(1) << data.entityId()
        << eprosima::fastcdr::MemberId(2) << data.isVirtualWeapon()
        << eprosima::fastcdr::MemberId(3) << data.dispositionType()
        << eprosima::fastcdr::MemberId(4) << data.targetID()
        << eprosima::fastcdr::MemberId(5) << data.targetName()
        << eprosima::fastcdr::MemberId(6) << data.targetType()
        << eprosima::fastcdr::MemberId(7) << data.taskType()
        << eprosima::fastcdr::MemberId(8) << data.executionState()
        << eprosima::fastcdr::MemberId(9) << data.executionTimeMs()
        << eprosima::fastcdr::MemberId(10) << data.online()
        << eprosima::fastcdr::MemberId(11) << data.position()
        << eprosima::fastcdr::MemberId(12) << data.elec()
        << eprosima::fastcdr::MemberId(13) << data.timestamp()
        << eprosima::fastcdr::MemberId(14) << data.deviceState()
        << eprosima::fastcdr::MemberId(15) << data.weaponState()
        << eprosima::fastcdr::MemberId(16) << data.hitPoint()
        << eprosima::fastcdr::MemberId(17) << data.launchPlatformID()
        << eprosima::fastcdr::MemberId(18) << data.launchPlatformName()
        << eprosima::fastcdr::MemberId(19) << data.attackAngle()
        << eprosima::fastcdr::MemberId(20) << data.missDistance()
        << eprosima::fastcdr::MemberId(21) << data.moveStep()
;
    scdr.end_serialize_type(current_state);
}

template<>
eProsima_user_DllExport void deserialize(
        eprosima::fastcdr::Cdr& cdr,
        casia::device::status::WeaponStatus::WeaponRealTimeStatus& data)
{
    using namespace casia::device::status::WeaponStatus;

    cdr.deserialize_type(eprosima::fastcdr::CdrVersion::XCDRv2 == cdr.get_cdr_version() ?
            eprosima::fastcdr::EncodingAlgorithmFlag::DELIMIT_CDR2 :
            eprosima::fastcdr::EncodingAlgorithmFlag::PLAIN_CDR,
            [&data](eprosima::fastcdr::Cdr& dcdr, const eprosima::fastcdr::MemberId& mid) -> bool
            {
                bool ret_value = true;
                switch (mid.id)
                {
                                        case 0:
                                                dcdr >> data.entityType();
                                            break;

                                        case 1:
                                                dcdr >> data.entityId();
                                            break;

                                        case 2:
                                                dcdr >> data.isVirtualWeapon();
                                            break;

                                        case 3:
                                                dcdr >> data.dispositionType();
                                            break;

                                        case 4:
                                                dcdr >> data.targetID();
                                            break;

                                        case 5:
                                                dcdr >> data.targetName();
                                            break;

                                        case 6:
                                                dcdr >> data.targetType();
                                            break;

                                        case 7:
                                                dcdr >> data.taskType();
                                            break;

                                        case 8:
                                                dcdr >> data.executionState();
                                            break;

                                        case 9:
                                                dcdr >> data.executionTimeMs();
                                            break;

                                        case 10:
                                                dcdr >> data.online();
                                            break;

                                        case 11:
                                                dcdr >> data.position();
                                            break;

                                        case 12:
                                                dcdr >> data.elec();
                                            break;

                                        case 13:
                                                dcdr >> data.timestamp();
                                            break;

                                        case 14:
                                                dcdr >> data.deviceState();
                                            break;

                                        case 15:
                                                dcdr >> data.weaponState();
                                            break;

                                        case 16:
                                                dcdr >> data.hitPoint();
                                            break;

                                        case 17:
                                                dcdr >> data.launchPlatformID();
                                            break;

                                        case 18:
                                                dcdr >> data.launchPlatformName();
                                            break;

                                        case 19:
                                                dcdr >> data.attackAngle();
                                            break;

                                        case 20:
                                                dcdr >> data.missDistance();
                                            break;

                                        case 21:
                                                dcdr >> data.moveStep();
                                            break;

                    default:
                        ret_value = false;
                        break;
                }
                return ret_value;
            });
}

void serialize_key(
        eprosima::fastcdr::Cdr& scdr,
        const casia::device::status::WeaponStatus::WeaponRealTimeStatus& data)
{
    extern void serialize_key(
            Cdr& scdr,
            const casia::device::status::BaseStatus::BaseDeviceStatus& data);
    serialize_key(scdr, static_cast<const casia::device::status::BaseStatus::BaseDeviceStatus&>(data));
}



