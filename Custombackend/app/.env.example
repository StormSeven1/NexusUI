# Keycloak Authentication（仅后端配置；前端通过 GET /api/v1/auth/config 获取）
# true=启用鉴权，false=禁用（便于联调/测试）
AUTH_ENABLED=false
KEYCLOAK_URL=http://192.168.18.141:1080
KEYCLOAK_REALM=airia-dev
KEYCLOAK_CLIENT_ID=fusion_management
# Optional client role required to access this application (resource_access[client].roles)
KEYCLOAK_REQUIRED_CLIENT_ROLE=

# 8090 实体列表轮询（与 nexus-ui NEXUS_ENTITIES_LIST_URL 同键）
# 未设置时：用仓库根 site-host.env 的 SITE_LAN_HOST 推导 http://{SITE}:8090/api/v1/entities?...
# NEXUS_ENTITIES_LIST_URL=http://192.168.18.141:8090/api/v1/entities?page=1&size=100
#
# 8090 开了 Keycloak 时（如 18.36 entity_mgr [auth] enable=1）：
# NEXUS_ENTITIES_AUTH_ENABLED=true
# NEXUS_ENTITIES_KEYCLOAK_CLIENT_ID=entity_management
# NEXUS_ENTITIES_KEYCLOAK_USERNAME=
# NEXUS_ENTITIES_KEYCLOAK_PASSWORD=
# （KEYCLOAK_URL / REALM 默认同上；也可用 NEXUS_ENTITIES_BEARER_TOKEN 直接塞 JWT）
NEXUS_ENTITIES_AUTH_ENABLED=false
